{
  "name": "mahoquot-workspace",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup-gateway.sh",
    "dev": "bun run tauri dev",
    "build": "bun run build:frontend && bun run build:app",
    "build:app": "bun run tauri build",
    "build:release": "bash scripts/build-release.sh",
    "build:frontend": "(cd crates/monitor-ui/frontend && bun install && bun run build)",
    "tauri": "cd crates/monitor-ui && bunx @tauri-apps/cli@2.11.4",
    "verify": "bash scripts/verify.sh"
  }
}
