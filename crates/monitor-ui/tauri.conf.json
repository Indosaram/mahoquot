{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mahoquot Monitor",
  "version": "0.1.0",
  "identifier": "dev.mahoquot.monitor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mahoquot Operations Console",
        "url": "index.html?v=2",
        "width": 1100,
        "height": 720,
        "resizable": true
      },
      {
        "label": "notch",
        "title": "Mahoquot",
        "url": "index.html?surface=notch&v=2",
        "width": 420,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}