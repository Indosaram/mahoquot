{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mahoquot",
  "version": "0.1.7",
  "identifier": "dev.mahoquot.mobile",
  "build": {
    "frontendDist": "../monitor-ui/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mahoquot",
        "url": "index.html",
        "width": 430,
        "height": 932,
        "minWidth": 320,
        "resizable": true,
        "backgroundColor": "#0B0B0D",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http: https:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
