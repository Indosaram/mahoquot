<?xml version="1.0" encoding="utf-8"?>
<!--
  The mobile app is remote-only: it reads usage from a gateway the user already
  runs, typically over a private overlay such as Tailscale, which serves plain
  HTTP. Android blocks cleartext by default, so a release build could not reach
  that gateway at all.

  Cleartext is therefore permitted globally here, and TLS is still used for any
  endpoint the user configures with https://. This is the only viable policy
  because Android <domain> entries cannot express the arbitrary IP a private
  overlay assigns, and the app cannot know it ahead of time.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
